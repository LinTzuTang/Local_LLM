{
 "_about": "Test conversations for the local GPT-Live (live voice assistant). The page plays them as a virtual microphone (each line spoken by a macOS voice, after the assistant has finished; a barge line cuts in while it reads a lookup result). `expect` is what the front LLM should do with each line: decision ask | tool | answer (any of the list; a reply ending in a question mark counts as ask), and for a tool the tool name and a place the location argument should contain (any of the list, case-insensitive). scripts/speech_eval/run_front_llm.py scores front LLMs against it.",
 "scripts": [
  {
   "id": "weather_places_zh",
   "lang": "zh",
   "name": {
    "zh": "中文：問天氣 → 反問地點 → 找早午餐 → 插話",
    "en": "Mandarin: weather → asked where → brunch places → barge-in"
   },
   "lines": [
    {
     "text": "今天天氣如何？",
     "expect": {
      "decision": [
       "ask"
      ]
     }
    },
    {
     "text": "我在內湖。",
     "expect": {
      "decision": [
       "tool"
      ],
      "tool": "get_weather",
      "location": [
       "內湖"
      ]
     }
    },
    {
     "text": "謝謝，這附近有什麼好吃的早午餐店嗎？",
     "expect": {
      "decision": [
       "tool"
      ],
      "tool": "search_places",
      "location": [
       "內湖"
      ]
     }
    },
    {
     "text": "好，那就第一家吧，謝謝！",
     "barge": true,
     "expect": {
      "decision": [
       "answer",
       "ask"
      ]
     }
    }
   ]
  },
  {
