LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=qwen3:30b-a3b
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_CONTEXT=16384
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TIMEOUT=180
# For vLLM behind an SSH tunnel:
# LOCAL_LLM_PROVIDER=vllm
# LOCAL_LLM_MODEL=Qwen/Qwen3-8B
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_API_KEY=local
# Turn thinking off when the model allows it (models that always think ignore this).
LOCAL_LLM_QWEN_NO_THINK=true
LANGSMITH_TRACING=false
# Streamlit platform: GPU memory budget in GB for the multi-model warning.
# LOCAL_LLM_GPU_BUDGET_GB=44
# Model gateway (speech-to-text, document parsing, reranker); see docs/GATEWAY.md.
# LOCAL_LLM_GATEWAY_PORT=11500
# LOCAL_LLM_GATEWAY_KEEP_ALIVE=300
# LOCAL_LLM_GATEWAY_MAX_UPLOAD_MB=200
